# ==============================================================================
# BET CRM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NOTA: NUNCA INCLUA CREDENCIAIS REAIS NESTE ARQUIVO OU NO REPOSITÓRIO GIT.
# ==============================================================================

# Configuração da Aplicação
APP_NAME="BET CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging & Telemetria
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de Dados Principal (PostgreSQL 16+)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bet_crm
DB_USERNAME=bet_crm_user
DB_PASSWORD=change_this_secret_password
DB_SCHEMA=public

# Cache & Sessões (Redis 7+)
CACHE_STORE=redis
CACHE_PREFIX=bet_crm_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Filas & Processamento Assíncrono (Laravel Queue + Horizon)
QUEUE_CONNECTION=redis
HORIZON_PREFIX=bet_crm_horizon

# Instância do Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Configurações de Envio de E-mail (Driver Padrão em Dev: Mock/Log)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@crm.example.com"
MAIL_FROM_NAME="BET CRM"

# ==============================================================================
# MODO DE DESENVOLVIMENTO / MOCK DE PROVEDORES DE MENSAGERIA
# Em ambientes 'local' ou 'staging', MOCK_PROVIDERS deve ser sempre 'true'.
# Nenhuma chamada real externa será feita.
# ==============================================================================
MOCK_PROVIDERS=true

# Provedores Reais (Habilitados apenas em produção se MOCK_PROVIDERS=false)
# Zenvia
ZENVIA_ENABLED=false
ZENVIA_API_KEY=
ZENVIA_FROM=

# Brevo (antigo Sendinblue)
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="BET CRM"

# Infobip
INFOBIP_ENABLED=false
INFOBIP_API_KEY=
INFOBIP_BASE_URL=

# SendGrid
SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME="BET CRM"

# ==============================================================================
# SEGURANÇA E WEBHOOKS
# ==============================================================================
WEBHOOK_DEFAULT_SECRET=
SANCTUM_STATEFUL_DOMAINS="localhost:3000,crm.example.com"
