APP_NAME="BET CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bet_crm
DB_USERNAME=bet_crm_user
DB_PASSWORD=change_this_secret_password
DB_SCHEMA=public

CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MOCK_PROVIDERS=true
ZENVIA_ENABLED=false
BREVO_ENABLED=false
INFOBIP_ENABLED=false
SENDGRID_ENABLED=false
