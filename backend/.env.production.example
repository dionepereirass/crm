# ==============================================================================
# BET CRM — Modelo de Configuração de Ambiente para Produção (Backend Laravel)
# NUNCA insira senhas reais neste arquivo versionado. Copie para .env no servidor.
# ==============================================================================

APP_NAME="BET CRM"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GERAR_COM_PHP_ARTISAN_KEY_GENERATE
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://crm.seudominio.com
FRONTEND_URL=https://crm.seudominio.com

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Banco de Dados PostgreSQL (Privado, sem porta exposta à Internet)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bet_crm_prod
DB_USERNAME=bet_crm_app
DB_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI_MINIMO_32_CHARS
DB_SCHEMA=public

# Cache e Sessões via Redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Conexão Redis (Privado com autenticação obrigatória)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=DEFINA_UMA_SENHA_FORTE_PARA_O_REDIS
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS="crm.seudominio.com"
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=betcrm_

# Provedores de Envio (Habilitar apenas provedores oficiais contratados)
MOCK_PROVIDERS=false
ZENVIA_ENABLED=false
BREVO_ENABLED=false
INFOBIP_ENABLED=false
SENDGRID_ENABLED=false

# Laravel Horizon
HORIZON_PREFIX=betcrm_horizon:

# Mail e Notificações de Alertas Operacionais
MAIL_MAILER=smtp
MAIL_HOST=smtp.seudominio.com
MAIL_PORT=587
MAIL_USERNAME=SEU_USUARIO_SMTP
MAIL_PASSWORD=SUA_SENHA_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seudominio.com
MAIL_FROM_NAME="BET CRM Operações"
